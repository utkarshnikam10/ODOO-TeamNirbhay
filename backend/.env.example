# Application Settings
PROJECT_NAME="StockSense Inventory Management System"
API_V1_STR="/api/v1"
ENVIRONMENT="development"
DEBUG=True

# JWT Authentication
JWT_SECRET_KEY="replace-this-with-a-secure-random-secret-key-in-production"
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440
PASSWORD_RESET_EXPIRE_MINUTES=15

# PostgreSQL Database Configuration
POSTGRES_SERVER=localhost
POSTGRES_PORT=5433
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=stocksense_db

# Optional Direct DATABASE_URL override
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5433/stocksense_db
